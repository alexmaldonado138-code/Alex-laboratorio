#include<iostream>

using namespace std;

int main()
{
    char opcion;
    double peso,costoTotal;
    char L,C,S,X;
    do {
    cout<<"L. La Paz/ El Alto"<<endl;
    cout<<"C. Cochabamba"<<endl;
    cout<<"S. Santa Cruz"<<endl;
    cout<<"X. Salir del sistema"<<endl;
    cout<<"Seleccione una opcione:";
    cin>> opcion;
    switch (opcion) {
    case 'L':
        cout<<"Ingrese el peso del paquete en kg:";
        cin>>peso;
        if (peso<=2) {
            costoTotal=7.00;
        } else {
            costoTotal=7.00+(peso-2)*3.00;
        } 
        cout<<"El costo de envio a La Paz/El Alto es:Bs"<<costoTotal<<endl;
        break;
        
    case 'C':
        cout<<"Ingrese el peso del paquete en kg:";
        cin>>peso;
        if(peso<=2) {
            costoTotal=5.00;
        } else {
            costoTotal=5.00+(peso-2)*2.00;
        }
        cout<<"El costo de envio a Cochabamba es:Bs"<<costoTotal<<endl;
        break;
        
    case 'S':
        cout<<"Ingrese el peso del paquete en kg:";
        cin>>peso;
        if(peso<=2) {
           costoTotal=8.00;
        } else {
            costoTotal=8.00+(peso-2)*4.00;
        }
        cout<<"El costo de envio a Santa Cruz es:Bs"<<costoTotal<<endl;
        break;
        
    case 'X':
        cout<<"Saliendo del sistema...gracias"<<endl;
        break;
         
    default:
        cout<<"Opcion no valida. Intente de nuevo."<<endl;
        break;
        } 
    } while (opcion !='x');
    return 0;
}
