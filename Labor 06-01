#include<iostream>

using namespace std;

int main() 
{
    int N;
    double suma=0.0;
    cout<<"Ingrese un N:";
    cin>>N;
    
    do {
        cout<<"Ingrese un N:";
        cin>>N;
        if(N<=0) {
            cout<<"Error";
        }
    } 
    while(N>=0);
    
    for(int i=1;i<=N;i++) {
        suma+=1.0/i;
    }
    cout<<"La suma de la serie S para N="<<N<<"es:"<<suma<<endl;
    return 0;
}
