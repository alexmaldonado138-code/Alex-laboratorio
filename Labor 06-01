#include<iostream>

using namespace std;

int main() 
{
    int N;
    double suma=0.0;
    
    do {
        cout<<"Ingrese un numero entero positivo N:";
        cin>>N;
        if(N<=0) {
            cout<<"Error:El numero debe ser mayor a 0";
        }    
    } while(N<=0);
    
    for(int i=1;i<=N;i++) {
        if(i%2 !=0) {
            suma+=1.0/i;
        } else {
            suma-=1.0/i;
        }
    }
    
    cout<<"La suma de la serie S para N="<<N<<" es "<<suma<<endl;
    
    return 0;
}
