#include<iostream>

using namespace std;

int main() 
{
    double combustible_restante=50.0;
    double combustible_consumido=0.0;
    double consumo_viaje;
    int entregas_realizadas=0;
    
    cout<<"Combustible inicial:"<<combustible_restante<<"litros"<<endl;
    
    while (combustible_restante>10.0) {
        cout<<"Ingrese la cantitad de litros consumidos en la entrega"<<(entregas_realizadas+1)<<":";
        cin>>consumo_viaje;
        
        if (consumo_viaje<0) {
            cout<<"Error";
            continue;
        }
        entregas_realizadas++;
        combustible_consumido+=consumo_viaje;
        combustible_restante-=consumo_viaje;
        
        cout<<"combustible restante actual:"<<combustible_restante<<"litros"<<endl;
    }
    
    cout<<"Cantitad de entregas realizadas:"<<entregas_realizadas<<endl;
    cout<<"Total de combustibe consumido:"<<combustible_consumido<<"litros"<<endl;
    cout<<"Combustible restante:"<<combustible_restante<<"litros"<<endl;
    cout<<"Debe cargar combustible"<<endl;
    return 0;
}
