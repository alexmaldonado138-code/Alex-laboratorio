#include<iostream>

using namespace std;

void leerVentas(double ventas, int tamano);
void procesarVentas(const double ventas, int tamano,double &total, double &promedio, int &diasSuperiores);
void mostrarResultados(double total, double promedio, int diasSuperiores);

int main ()
{
  const int dias=5;
  double ventas;
  double promedio=0.0;
  double total=0.0;
  int diasSuperiores=0;
  
  leerVentas(ventas,dias);
  procesarVentas(ventas, dias, total, promedio, diasSuperiores);
  mostrarResultados(total, promedio, diasSuperiores);
  
  return 0;
}

void leerVentas(double ventas[], int tamano) {
    cout<<"Registro de ventas"<<endl;
    for(int i=0; i<tamano; i++) {
        cout<<"Ingrese la venta del dia"<<(i+1)<<":";
        cin>>ventas[i];
    }
}

void procesarVentas(const double ventas[], int tamano, double &total,double &promedio, int &diasSuperiores) {
    total=0.0;
    for(int i=0; i<tamano; i++) {
        total += ventas[i];
    }
    
    promedio=total/tamano;
    
    diasSuperiores=0;
    for(int i=0; i<tamano; i++) {
        if(ventas[i]>promedio) {
            diasSuperiores++;
        }
    }
}
void mostrarResultados(double total, double promedio, int diasSuperior) {
    cout<<"Total="<<total<<endl;
    cout<<"Dias superiores al promedio="<<diasSuperior<<endl;
}

}
