#include<iostream>

using namespace std;

int main() {
    int z; 
    int y; 
    double suma=0.0;
    double termino=1.0;
    
    cout<<"Ingrese un base (z): ";
    cin>>z;
    
    do { 
    cout<<"Ingrese un limite superior (y):";
    cin>>y;
    
    if(y<=1) {
        cout<<"Error";
      }
    } while(y<=1);
       
    for(int i=1;i<=y;i++) {
       termino=termino*z/i;
       suma+=termino;
    }
    
    cout<<"El resultado de la serie S es:"<<suma<<endl;
    
    return 0;
}
